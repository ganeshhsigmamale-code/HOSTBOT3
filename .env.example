# Railway Environment Variables Configuration

# GitHub Token (Required for backup)
# Create token at: https://github.com/settings/tokens
# Required permissions: repo (Full control of private repositories)
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Repository (Format: username/repository)
GITHUB_REPO=akbhai/host-bot

# Optional: Backup Configuration
# BACKUP_METHOD=api  # Auto-detected on Railway, no need to set
# GITHUB_BACKUP_ENABLED=true  # Default: true

# Port (Railway automatically sets this)
PORT=8080
